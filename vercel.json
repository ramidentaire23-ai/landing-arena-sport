{
  "version": 2,
  "functions": {
    "api/index.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/internal/reconcile",
      "schedule": "0 2 * * *"
    }
  ],
  "outputDirectory": "public",
  "buildCommand": "npm run build",
  "regions": [
    "fra1"
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ]
}
