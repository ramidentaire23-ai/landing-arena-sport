{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/merci",
      "destination": "/merci.html"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/internal/reconcile",
      "schedule": "0 2 * * *"
    }
  ],
  "outputDirectory": "public",
  "buildCommand": "npm run build",
  "regions": [
    "fra1"
  ]
}
